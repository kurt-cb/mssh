[Unit]
Description=msshd — mssh wrapper (mTLS-authenticated SSH frontend)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=_msshwrapper
Group=_msshwrapper
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/usr/local/bin/msshd --config /etc/mssh/wrapper.yaml
Restart=on-failure
RestartSec=5

# Sandboxing
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/log/mssh /var/lib/mssh
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
