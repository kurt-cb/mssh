# Emergency inner sshd_config template — used by msshd when the CA is
# unreachable AND an emergency cert is provisioned. See
# design/security.md "emergency cert" and design/ca.md "recovery".
#
# This file is shipped with mssh. The operator MAY override it at
# /etc/mssh/sshd_config.emergency.template with stricter or laxer
# break-glass defaults — but the override must pass `sshd -t` at
# msshd startup, or msshd refuses to start with a clear error
# pointing at the broken file.
#
# Only {LOCAL_*} markers — msshd substitutes them locally. There are
# NO {FROMCA_*} markers in this template because by definition the
# CA is unreachable on the path that uses it.

Port              {LOCAL_PORT}
HostKey           {LOCAL_HOST_KEY}
TrustedUserCAKeys {LOCAL_USER_CA_PUBKEY}
Banner            {LOCAL_BANNER_FILE}
ListenAddress     127.0.0.1

# Authentication — pinned, identical to the regular hermetic config.
PermitRootLogin                 no
PasswordAuthentication          no
KbdInteractiveAuthentication    no
ChallengeResponseAuthentication no
GSSAPIAuthentication            no
HostbasedAuthentication         no
PermitEmptyPasswords            no
UsePAM                          no
AuthenticationMethods           publickey
PubkeyAuthentication            yes
AuthorizedKeysFile              /dev/null
AuthorizedKeysCommand           none
AuthorizedPrincipalsFile        none

# Conservative defaults — no per-session policy in emergency mode.
# The emergency path is meant to recover access, not to reproduce
# normal per-policy behavior.
ForceCommand               none
AllowTcpForwarding         no
X11Forwarding              no
AllowAgentForwarding       no
PermitUserEnvironment      no
PermitTunnel               no
AllowStreamLocalForwarding no
GatewayPorts               no

# Crypto floor — same as the regular hermetic config.
KexAlgorithms            curve25519-sha256,curve25519-sha256@libssh.org
Ciphers                  chacha20-poly1305@openssh.com,aes256-gcm@openssh.com
MACs                     hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
HostKeyAlgorithms        ssh-ed25519
PubkeyAcceptedAlgorithms ssh-ed25519

LogLevel       VERBOSE
SyslogFacility AUTH
